# ===================================================
# Environment Variables Template
# Copy this file to .env and fill in your values.
# ===================================================
#
# .env contains SECRETS ONLY (credentials, tokens).
# Schema names, graph names, and test paths are in:
#   config/workflow_config.yml  — workflow/pipeline config
#   config/test_config.yml      — integration test defaults
# ===================================================

# ===================================================
# Database Credentials  (required for PostGIS backend)
# ===================================================
DB_NAME=your_database_name
DB_USER=postgres
DB_PASSWORD=your_password
DB_HOST=localhost
DB_PORT=5432

# ===================================================
# External API Tokens
# ===================================================
# Interactive map visualizations (optional)
# Get your token from: https://account.mapbox.com/access-tokens/
MAPBOX_TOKEN=your_mapbox_access_token_here

# ===================================================
# Integration Test Overrides  (optional)
# ===================================================
# These override the defaults in config/test_config.yml.
# Only needed if your test environment differs from the defaults.
#
# PostGIS schemas
# POSTGIS_ENC_SCHEMA=enc_west          # Schema where S-57 ENC layers are stored
# POSTGIS_GRAPH_SCHEMA=graph           # Schema where graph tables are stored
#
# Graph identifiers
# POSTGIS_UNDIRECTED_GRAPH_NAME=fine_graph_test_graph
# POSTGIS_GRAPH_NAME=fine_graph_directed_postgis_v10
#
# Data file paths (absolute or relative to project root)
# GPKG_SOURCE_PATH=data/fine_graph_test_graph.gpkg
# ENC_GPKG_PATH=data/enc_west.gpkg