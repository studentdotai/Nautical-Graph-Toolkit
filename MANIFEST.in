include README.md
include LICENSE.md
include THIRD_PARTY_LICENSES.md
include environment.yml
include requirements.in
include requirements.txt

recursive-include scripts *.py *.md
recursive-include docs *.md *.yml *.ipynb
recursive-include src/nautical_graph_toolkit/data *.csv *.yml
recursive-include tests *.py

# Explicitly exclude development tools
prune .claude
prune dev
exclude CLAUDE.md

global-exclude __pycache__
global-exclude *.pyc
global-exclude .DS_Store
global-exclude *.egg-info
